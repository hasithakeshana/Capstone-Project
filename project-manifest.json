{
  "name": "learnlab",
  "description": "LearnLab: greenfield Learning Management System web app with a responsive web UI for learners, instructors and admins (course catalog, enrollment, lessons, progress tracking, auto-graded MCQ/TRUE-FALSE quizzes). Internal tool. Stack: Python 3.12 + FastAPI (uv, ruff, mypy, pytest) backend in src/, tests/, migrations/; React + Vite + TypeScript + Tailwind frontend in frontend/; SQLite; Playwright E2E. Layered backend: controllers -> services -> repositories -> domain. Run with local dev servers (no Docker). Local-only tracker; no Linear or Jira.",
  "stack": {
    "backend": {
      "language": "python",
      "version": "3.12",
      "framework": "fastapi",
      "package_manager": "uv",
      "linter": "ruff",
      "typechecker": "mypy",
      "test_runner": "pytest"
    },
    "frontend": {
      "language": "typescript",
      "version": "5",
      "framework": "react",
      "package_manager": "npm",
      "linter": "eslint",
      "typechecker": "tsc",
      "test_runner": "vitest"
    },
    "database": {
      "primary": "sqlite",
      "secondary": null
    }
  },
  "lsp": {
    "servers": [
      {
        "language": "python",
        "server": "pyright",
        "binary": "pyright",
        "install": "npm i -g pyright"
      },
      {
        "language": "typescript",
        "server": "typescript-language-server",
        "binary": "typescript-language-server",
        "install": "npm i -g typescript-language-server typescript"
      }
    ]
  },
  "evaluation": {
    "api_base_url": "http://localhost:8000",
    "ui_base_url": "http://localhost:3000",
    "health_check": "/health",
    "design_score_threshold": 7,
    "design_max_iterations": 10,
    "test_corpus_dir": "specs/test_artefacts"
  },
  "execution": {
    "default_mode": "full",
    "model_tier": "cost",
    "ceremony": "full",
    "session_chaining": true,
    "teammate_model": "sonnet",
    "// budget": "unset — /auto uses the model_tier default cap (cost tier ~= 80 agents / $8 / 30 min). To enforce a per-build ceiling, replace this key with  budget: { est_cost_usd, agents, wall_clock_ms }  — or pass --budget at run time. See docs/token-cost-playbook.md."
  },
  "verification": {
    "mode": "local",
    "local": {
      "backend_url": "http://localhost:8000",
      "frontend_url": "http://localhost:3000",
      "start_commands": []
    }
  },
  "topology": "web-app",
  "architecture": {
    "layers": ["core", "domain", "repositories", "services", "controllers"],
    "layer_roots": ["src"]
  },
  "quality": {
    "sensor_tier": "standard",
    "agent_readiness": {
      "mode": "report",
      "min_active_pillars": 3,
      "forbid_regression": false
    },
    "sast_engine": "semgrep",
    "mutation": {
      "tool": "mutmut",
      "config_file": "pyproject.toml",
      "critical_globs": []
    }
  },
  "token_governor": {
    "enabled": true,
    "mode": "enforced",
    "living_navigation": true,
    "context_search_required": true,
    "max_source_read_lines": 300,
    "tool_output_token_estimates": true,
    "compress_tool_output": true,
    "ccr_enabled": true,
    "preserve_full_outputs": true,
    "budget_warn_pct": 80
  },
  "observability": {
    "enabled": true,
    "metrics_path": "/metrics",
    "red_labels": [
      "method",
      "route",
      "status"
    ],
    "slo": {
      "error_rate_pct": 1,
      "p95_ms": 500
    }
  },
  "framework_skill_packs": [
    "fastapi-code",
    "react-code"
  ],
  "custom_sensors": [],
  "github": {
    "org": "",
    "default_branch": "main",
    "required_checks": [
      "gitleaks",
      "sast"
    ],
    "required_approvals": 1,
    "require_code_owner_review": true,
    "enforce_admins": true,
    "ruleset_scope": "org",
    "ruleset_name": "harness-baseline-protection",
    "target_repos": "~ALL",
    "default_owners": [],
    "environments": [
      {
        "name": "production",
        "reviewers": [],
        "wait_timer": 0,
        "protected_branches": true
      }
    ]
  },
  "harness_version": "3.0.0"
}
